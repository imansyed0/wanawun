# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local tool output
/supabase/.temp/
/test-results/

# Local agent state stays out of git, but the skills are committed: git can't
# look inside an excluded directory, so exclude .claude's children instead.
/.claude/*
!/.claude/skills/
/.claude/skills/*/shots/

# scraped course audio — lives in the `course-audio` Supabase bucket (scripts/uploadCourseAudio.js)
/data/audio/

# generated preview HTML (regenerate via data/preview_ciil_locally.js etc.)
/data/preview/
